<resources>
    <style name="Theme.TestDialer" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/ui_accent</item>
        <item name="android:buttonStyle">@style/Widget.TestDialer.Button</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="android:navigationBarColor">@color/ui_surface</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Widget.TestDialer.Button" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
</resources>
